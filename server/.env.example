# pyhire-site-api configuration.
# Copy to .env on the server and fill in. Never commit the filled-in file.

PORT=8060

# Where enquiries are delivered.
MAIL_TO=support@veriright.com
# Envelope sender. Must be an address your SMTP provider allows you to send as,
# otherwise the message is rejected or lands in spam.
MAIL_FROM=support@veriright.com

# SMTP transport. Reuse the same provider your other apps on this server use.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on port 465; false for STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
